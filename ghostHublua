-- ============================================
-- LOOP PRINCIPAL
-- ============================================
task.spawn(function()
    while true do
        pcall(function()
            local hrp = GetHRP()
            if not hrp then return end
            
            if Config.AntiAFK then
                VirtualInputManager:SendMouseButtonEvent(0,0,0,true,nil,0)
                task.wait(0.02)
                VirtualInputManager:SendMouseButtonEvent(0,0,0,false,nil,0)
            end
            
            if Config.FlyEnabled then
                local h = GetHumanoid()
                if h then h.PlatformStand = true hrp.Velocity = Vector3.new(0, Config.FlySpeed, 0) end
            end
            
            if Config.BringMob then
                for i, e in pairs(GetEnemies()) do
                    pcall(function()
                        e.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(math.random(-2,2), 0, -3-i)
                        e.HumanoidRootPart.Velocity = Vector3.zero
                    end)
                end
            end
            
            if Config.AutoFarm then
                local e = GetNearestEnemy()
                if e then
                    statusLabel.Text = "⚔️ " .. e.Name
                    EquipWeapon()
                    if not Config.BringMob then hrp.CFrame = e.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5) end
                    Attack()
                else
                    statusLabel.Text = "🔍 Procurando..."
                end
            end
            
            if Config.AutoQuest then
                for _, n in pairs(Workspace:GetDescendants()) do
                    pcall(function()
                        if n.Name:lower():find("quest") and n:FindFirstChild("Head") and (n.Head.Position - hrp.Position).Magnitude < 50 then
                            hrp.CFrame = n.Head.CFrame * CFrame.new(0,0,-3)
                            task.wait(0.3)
                            VirtualInputManager:SendMouseButtonEvent(0,0,0,true,nil,0)
                            task.wait(0.1)
                            VirtualInputManager:SendMouseButtonEvent(0,0,0,false,nil,0)
                        end
                    end)
                end
            end
            
            if Config.AutoBoss then
                for _, e in pairs(GetEnemies()) do
                    pcall(function()
                        if e.Name:lower():find("boss") then
                            statusLabel.Text = "💀 " .. e.Name
                            EquipWeapon()
                            hrp.CFrame = e.HumanoidRootPart.CFrame * CFrame.new(0,0,-5)
                            Attack()
                        end
                    end)
                end
            end
            
            if Config.AutoSeaBeast then
                for _, o in pairs(Workspace:GetDescendants()) do
                    pcall(function()
                        if o.Name:lower():find("sea") and o:FindFirstChild("Humanoid") and o.Humanoid.Health > 0 then
                            statusLabel.Text = "🌊 Sea Beast!"
                            EquipWeapon()
                            hrp.CFrame = o.HumanoidRootPart.CFrame * CFrame.new(0,0,6)
                            Attack()
                        end
                    end)
                end
            end
            
            if Config.AutoFruitSniper then
                for _, o in pairs(Workspace:GetDescendants()) do
                    pcall(function()
                        if o:IsA("BasePart") and o.Name:lower():find("fruit") and o.Name ~= "Fruit" then
                            if (o.Position - hrp.Position).Magnitude < 200 then
                                hrp.CFrame = o.CFrame + Vector3.new(0, 3, 0)
                                task.wait(0.5)
                            end
                        end
                    end)
                end
            end
            
            if Config.AutoHaki then pcall(function() VirtualInputManager:SendKeyEvent(true,"E",false,nil) task.wait(0.1) VirtualInputManager:SendKeyEvent(false,"E",false,nil) end) end
            if Config.AutoKen then pcall(function() VirtualInputManager:SendKeyEvent(true,"T",false,nil) task.wait(0.1) VirtualInputManager:SendKeyEvent(false,"T",false,nil) end) end
            if Config.AutoSoru then pcall(function() VirtualInputManager:SendKeyEvent(true,"Q",false,nil) task.wait(0.1) VirtualInputManager:SendKeyEvent(false,"Q",false,nil) end) end
            if Config.AutoBuso then pcall(function() VirtualInputManager:SendKeyEvent(true,"R",false,nil) task.wait(0.1) VirtualInputManager:SendKeyEvent(false,"R",false,nil) end) end
            
        end)
        task.wait(0.12)
    end
end)

